# Repo-root scope -> registry mapping for the private @izzywdev/* packages.
#
# FuzeAgent has no root package.json, so npm does NOT read this file when installing
# services/ui-react — that install reads services/ui-react/.npmrc. This root copy is
# for tooling and ad-hoc commands run from the repo root, which would otherwise hit
# the public registry and 404 for every private scope.
#
# @izzywdev is the scope npm actually FETCHES: GitHub Packages requires the scope to
# match the owning account, so @fuzefront/... 404s and the published package is
# @izzywdev/fuzefront-*.
@izzywdev:registry=https://npm.pkg.github.com
@fuzefront:registry=https://npm.pkg.github.com

# Authenticate with a scoped token from the environment: GITHUB_TOKEN in CI, or a PAT
# with read:packages locally. Never commit the token.
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
always-auth=true
